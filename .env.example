# GitHub App credentials
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub App private key — set ONE of the two ways:
# 1) inline PEM (newlines as \n):
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# 2) path to a .pem file (takes precedence; for docker-compose this is a host path
#    that is mounted into the container):
# GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# LLM provider: openai | anthropic
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_COMPLEX_MODEL=gpt-4.1

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
REVIEW_MODEL=claude-sonnet-4-6
COMPLEX_MODEL=claude-opus-4-8

# ngrok (for the local tunnel via docker-compose)
# Free token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Behaviour
AUTO_REVIEW_ON_REQUEST=true   # review when the bot is requested as a reviewer
AUTO_REVIEW_ON_OPEN=false     # also review automatically on PR open/reopen
AUTO_REVIEW_ON_SYNC=false     # re-review on new commits (git push OR GitHub UI,
                              # e.g. "Commit suggestion"); skips the bot's own pushes
MAX_DIFF_CHARS=120000
GRAPH_TIMEOUT=120
CLONE_DEPTH=100

# Git identity for commits the bot pushes when applying fixes
GIT_AUTHOR_NAME=ai-reviewer[bot]
GIT_AUTHOR_EMAIL=ai-reviewer[bot]@users.noreply.github.com
